page{background-color:#fffdf7;color:#17292c;font-family:Noto Sans SC,PingFang SC,Helvetica Neue,system-ui,sans-serif;font-size:28rpx;line-height:1.6}view,text,image,button,input,textarea,scroll-view{box-sizing:border-box}button{padding:0;margin:0;line-height:inherit;background:transparent}button:after{border:none}.flex{display:flex;align-items:center}.flex-between{display:flex;align-items:center;justify-content:space-between}.flex-center{display:flex;align-items:center;justify-content:center}.ellipsis{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.ellipsis-2{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}.card{background:#fff;border:1rpx solid #e7e5dc;border-radius:28rpx;padding:24rpx}.section-title{display:flex;align-items:center;justify-content:space-between;margin:32rpx 32rpx 20rpx}.section-title .title{font-size:32rpx;font-weight:700;letter-spacing:-.5rpx}.section-title .more{font-size:24rpx;color:#718083}.tag{display:inline-flex;align-items:center;padding:6rpx 14rpx;font-size:22rpx;color:#6b7878;background:#f2f2ec;border-radius:10rpx}
page{--status-bar-height:25px;--top-window-height:0px;--window-top:0px;--window-bottom:0px;--window-left:0px;--window-right:0px;--window-magin:0px}[data-c-h="true"]{display: none !important;}